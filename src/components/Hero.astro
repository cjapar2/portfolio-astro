---

---

<section id="intro" class="hero">
  <div class="wrap hero-content">
    <p class="eyebrow">hardware + software engineer</p>
    <h1 class="name">
      Hi, I'm <span class="gradient-text">Christian Apar</span><span
        class="caret"
        aria-hidden="true"></span>
    </h1>
    <p class="tagline">
      I like figuring out how things work and making them work better. My
      experience spans software, robotics, and hardware, with a focus on
      building technology that solves problems outside of a development
      environment.
    </p>
    <div class="hero-actions">
      <a class="cta" href="#work">
        See my work <span aria-hidden="true">→</span>
      </a>
      <a class="cta-secondary" href="#contact">Get in touch</a>
    </div>
  </div>
</section>

<style>
  .hero {
    border-top: none;
    padding-top: 96px;
    padding-bottom: 88px;
  }

  .name {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.15;
  }

  .caret {
    display: inline-block;
    width: 7px;
    height: 0.75em;
    margin-left: 6px;
    background: var(--accent-pink);
    vertical-align: -0.05em;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%,
    45% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .tagline {
    margin-top: 22px;
    max-width: 56ch;
    font-size: 19px;
    line-height: 1.7;
    color: var(--text-dim);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 36px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 22px;
    text-decoration: none;
    color: var(--bg-void);
    background: var(--accent-mint);
    border-radius: var(--radius);
    font-size: 15px;
    font-weight: 600;
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    transition:
      background 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .cta:hover,
  .cta:focus-visible {
    background: var(--accent-pink);
    transform: translateY(-1px);
    box-shadow: 0 0 24px var(--glow-pink);
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: 13px 22px;
    text-decoration: none;
    color: var(--text-main);
    background: var(--bg-void);
    border: 1px solid var(--line-hair);
    border-radius: var(--radius);
    font-size: 15px;
    font-weight: 500;
    transition:
      border-color 0.15s ease,
      background 0.15s ease,
      box-shadow 0.15s ease;
  }

  .cta-secondary:hover,
  .cta-secondary:focus-visible {
    border-color: var(--accent-mint-dim);
    background: var(--bg-surface);
    box-shadow: 0 0 20px var(--glow-mint);
  }
</style>
