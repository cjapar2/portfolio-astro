---
import { getCollection } from "astro:content";

const projects = await getCollection("projects");

const sortedProjects = projects.sort(
  (a, b) => b.data.sortOrder - a.data.sortOrder
);
---

<section id="work" class="work">
  <div class="wrap-wide">
    <p class="eyebrow">work</p>
    <h2 class="heading">Selected projects</h2>

    <div class="projects-grid">
      {
        sortedProjects.map((p) => 
        (
          <a class="project-card" href={p.data.href}>
            <div class="card-top">
              <h3 class="project-name">{p.data.title}</h3>
            </div>
            <p class="summary">{p.data.description}</p>
            <ul class="stack">
              {p.data.stack.map((s) => (
                <li class="mono">{s}</li>
              ))}
            </ul>
            <span class="view-link">View case study →</span>
          </a>
        )
      )
      }
    </div>
  </div>
</section>

<style>
  .heading {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin-bottom: 32px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }

  .project-card {
    display: block;
    text-decoration: none;
    color: var(--text-main);
    background: var(--bg-surface);
    border: 1px solid var(--line-hair);
    border-radius: var(--radius);
    padding: 24px 26px;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }

  .project-card:hover,
  .project-card:focus-visible {
    border-color: var(--accent-mint-dim);
    background: var(--bg-surface-raised);
    transform: translateY(-2px);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }

  .project-name {
    font-size: 19px;
  }

  .status {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .status-live {
    color: var(--accent-mint);
    border: 1px solid var(--accent-mint-dim);
  }

  .status-open-source {
    color: var(--accent-pink);
    border: 1px solid var(--accent-pink);
  }

  .status-in-progress {
    color: var(--text-dim);
    border: 1px solid var(--line-hair);
  }

  .summary {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-dim);
    margin-bottom: 16px;
  }

  .stack {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .stack li {
    font-size: 11.5px;
    color: var(--text-dim);
    border: 1px solid var(--line-hair);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .view-link {
    display: inline-block;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--accent-mint);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .project-card:hover .view-link,
  .project-card:focus-visible .view-link {
    opacity: 1;
    transform: translateX(0);
  }
</style>
