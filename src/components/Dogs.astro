---
// Fluff section — swap in real names, breeds, and fun facts.
// To use a real photo: drop the image file in /public/dogs/ (e.g.
// /public/dogs/rex.jpg) and set `photo` to that path, starting with "/dogs/".
// Leave `photo` blank to keep the placeholder doodle.
const dogs = [
  {
    name: 'Kai',
    breed: 'Yorkie mix',
    fact: 'Loves to jump on my lap to watch me work (and play video games).',
    photo: '/dogs/kai.jpg',
  },
  {
    name: 'Bomi',
    breed: 'Malamute mix',
    fact: "Always has something to say.",
    photo: '/dogs/bomi.jpg',
  },
];
---

<section id="dogs" class="dogs">
  <div class="wrap-wide">
    <p class="eyebrow">the real team</p>
    <h2 class="heading">My fluffy companions</h2>
    <p class="intro">
      They don't review my code, but they're around for all of it.
    </p>

    <div class="dogs-grid">
      {
        dogs.map((dog) => (
          <div class="dog-card">
            {dog.photo ? (
              <div class="dog-photo has-photo">
                <img src={dog.photo} alt={dog.name} loading="lazy" />
              </div>
            ) : (
              <div class="dog-photo" aria-hidden="true">
                <svg viewBox="0 0 100 100" class="dog-doodle">
                  <circle cx="50" cy="55" r="30" fill="none" stroke="currentColor" stroke-width="3" />
                  <path d="M28 40 Q20 15 35 28" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                  <path d="M72 40 Q80 15 65 28" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                  <circle cx="40" cy="52" r="3" fill="currentColor" />
                  <circle cx="60" cy="52" r="3" fill="currentColor" />
                  <path d="M45 65 Q50 70 55 65" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                </svg>
                <span class="photo-note mono">photo coming soon</span>
              </div>
            )}
            <h3 class="dog-name">{dog.name}</h3>
            <p class="dog-breed mono">{dog.breed}</p>
            <p class="dog-fact">{dog.fact}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dogs {
    background: var(--bg-surface);
  }

  .heading {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin-bottom: 10px;
  }

  .intro {
    font-size: 16px;
    color: var(--text-dim);
    margin-bottom: 36px;
  }

  .dogs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
    max-width: 640px;
  }

  .dog-card {
    background: var(--bg-void);
    border: 1px solid var(--line-hair);
    border-radius: var(--radius);
    padding: 22px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .dog-card:hover {
    border-color: var(--accent-pink);
    transform: translateY(-2px);
  }

  .dog-photo {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    aspect-ratio: 1;
    border-radius: calc(var(--radius) - 2px);
    border: 1px dashed var(--line-hair);
    color: var(--accent-pink);
    margin-bottom: 16px;
  }

  .dog-doodle {
    width: 56%;
  }

  .has-photo {
    border-style: solid;
    padding: 0;
    overflow: hidden;
  }

  .has-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-note {
    font-size: 11px;
    color: var(--text-faint);
  }

  .dog-name {
    font-size: 17px;
    margin-bottom: 2px;
  }

  .dog-breed {
    font-size: 12.5px;
    color: var(--accent-mint);
    margin-bottom: 10px;
  }

  .dog-fact {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-dim);
  }
</style>
