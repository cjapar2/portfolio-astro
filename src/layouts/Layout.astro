---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Christian Apar, Engineer',
  description = 'Engineer working across hardware and software. Portfolio, resume, and projects.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Runs before paint so there's no flash of the wrong theme.
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      function applyTheme(theme: string) {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
        document.dispatchEvent(new CustomEvent('themechange', { detail: { theme } }));
      }

      function currentTheme() {
        return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      }

      document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          applyTheme(currentTheme() === 'light' ? 'dark' : 'light');
        });
      });

      document.addEventListener('themechange', (e: Event) => {
        const theme = (e as CustomEvent).detail.theme;
        document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((btn) => {
          btn.setAttribute('aria-pressed', String(theme === 'light'));
        });
      });

      // sync initial button state on load
      document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((btn) => {
        btn.setAttribute('aria-pressed', String(currentTheme() === 'light'));
      });
    </script>
  </body>
</html>
